# toolkits/cu134.env -- CUDA 13.4 toolkit definition for tuned builds.
# Loaded by gpu_tuned_load_toolkit; do not execute. The file name is the
# toolkit id (CUDA_TAG). An optional toolkits/<variant>-cu134.env is sourced
# after this one and overrides any key where the stack differs per variant.
#
# Every value below was read from a real install, not assumed. Observed on
# geo-a-node-gb10-1 (aarch64, 2026-10-11):
#   /usr/local/cuda-13.4/bin/nvcc --version  -> release 13.4, V13.4.92
# TOOLKIT_NCCL_VERSION="none": no system libnccl2 is supported for this toolkit. The libnccl2
# installed on that node is 2.31.2-1+cuda13.3 (built for 13.3); apt offers 2.32.3-1+cuda13.4, but it
# has not been installed or checked here, so no system pin is recorded. A build for this toolkit that
# needs NCCL must take it from a pinned zbrad/nccl release (a tuned/nccl.pins entry, fetched with
# gpu_tuned_fetch_nccl_release); bundling the system libnccl2 is refused
# (gpu_tuned_verify_bundled_cuda_flavor). Every toolkit file must define this key, so adding a
# toolkit forces the NCCL question to be answered (tests/test_common.sh checks it).

TOOLKIT_ID="cu134"
TOOLKIT_CUDA_VER="13.4"
# Always the toolkit-versioned directory, never the unversioned /usr/local/cuda
# symlink (it points at whichever toolkit is newest, not the one pinned here).
TOOLKIT_CUDA_HOME="/usr/local/cuda-13.4"
# Must equal the "release X.Y" that nvcc prints.
TOOLKIT_NVCC_RELEASE="13.4"
TOOLKIT_NCCL_VERSION="none"
