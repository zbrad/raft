# toolkits/cu133.env -- CUDA 13.3 toolkit definition for tuned builds.
# Loaded by gpu_tuned_load_toolkit; do not execute. The file name is the
# toolkit id (CUDA_TAG). An optional toolkits/<variant>-cu133.env is sourced
# after this one and overrides any key where the stack differs per variant.
#
# Every value below was read from a real install, not assumed. Observed on
# geo-a-node-gb10-1 (aarch64, 2026-10-08):
#   /usr/local/cuda-13.3/bin/nvcc --version  -> release 13.3, V13.3.73
#   dpkg-query -W libnccl2                   -> 2.31.2-1+cuda13.3
# Not recorded because not verified: CCCL, cuDNN, other libs. Add a key here
# when a build depends on it and it has been read from the install.

TOOLKIT_ID="cu133"
TOOLKIT_CUDA_VER="13.3"
# Always the toolkit-versioned directory, never the unversioned /usr/local/cuda
# symlink (it points at whichever toolkit is newest, not the one pinned here).
TOOLKIT_CUDA_HOME="/usr/local/cuda-13.3"
# Must equal the "release X.Y" that nvcc prints.
TOOLKIT_NVCC_RELEASE="13.3"
# Debian package version of libnccl2 that is built for this toolkit. apt holds
# one libnccl2 at a time, so a different toolkit needs a different value.
TOOLKIT_NCCL_VERSION="2.31.2-1+cuda13.3"
